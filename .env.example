# API WARS 2026 - plantilla de variables. Copiar a .env y rellenar.
# Las credenciales reales se pasan por privado, nunca por el grupo ni por git.

# Factus API v2 (facturacion electronica DIAN) - credenciales sandbox v2 que dio la organizacion
FACTUS_ENV=sandbox
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Factus API v1 - respaldo opcional (solo sirve en /v1/*)
FACTUS_V1_CLIENT_ID=
FACTUS_V1_CLIENT_SECRET=
FACTUS_V1_USERNAME=
FACTUS_V1_PASSWORD=

# Factus Pay (recaudos con QR Bre-B) - cuenta del equipo que envio la organizacion
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
FACTUS_PAY_DOCS_URL=https://pay-developers.factus.com.co/

# Factus Pay - cuenta de respaldo (opcional)
FACTUS_PAY_PERSONAL_EMAIL=
FACTUS_PAY_PERSONAL_PASSWORD=

# WhatsApp (Meta Cloud API)
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_BUSINESS_ID=
META_APP_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
WHATSAPP_NUMERO_PUBLICO=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Panel del vendedor
PANEL_USUARIO=firebox
PANEL_CLAVE=
