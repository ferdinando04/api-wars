# API WARS 2026 - plantilla de variables. Copiar a .env y rellenar.
# Las credenciales reales se pasan por privado, nunca por el grupo ni por git.

# Factus API (facturacion electronica DIAN)
FACTUS_ENV=sandbox
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=

# Factus API v2 (la cuenta v1 da 403 en /v2/*)
FACTUS_V2_CLIENT_ID=
FACTUS_V2_CLIENT_SECRET=
FACTUS_V2_USERNAME=
FACTUS_V2_PASSWORD=

# Factus Pay (recaudos con QR Bre-B)
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
FACTUS_PAY_DOCS_URL=https://pay-developers.factus.com.co/
